# SisterCircle+ Frontend — Environment Variables
# Copy to .env.local. Never commit .env.local.
# Variables must be prefixed with NEXT_PUBLIC_ to be exposed to the browser
# (Next.js convention — anything without this prefix stays on the server).

# Django backend URL — no trailing slash
NEXT_PUBLIC_API_URL=http://10.1.7.101:8000

# NOTE: The Anthropic API key lives in the Django backend (.env).
# It must NEVER appear here or in any NEXT_PUBLIC_ variable.
