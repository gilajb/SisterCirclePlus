# SisterCircle+ Frontend — Environment Variables
# Copy to .env.local. Never commit .env.local.
# Variables must be prefixed with VITE_ to be exposed to the browser
# (Vite convention — anything without this prefix is not injected into client code).

# Django backend URL — no trailing slash
VITE_API_URL=http://localhost:8000

# App environment
VITE_APP_ENV=development

# NOTE: The Anthropic API key lives in the Django backend (.env).
# It must NEVER appear here or in any VITE_ variable.
