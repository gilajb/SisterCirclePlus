# SisterCircle+ Frontend — Environment Variables
# Copy to .env.local. Never commit .env.local.
# Variables WITHOUT NEXT_PUBLIC_ are server-only (Next.js API routes).
# Variables WITH NEXT_PUBLIC_ are safe to expose to the browser.

# Django backend URL — no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# App environment
NEXT_PUBLIC_APP_ENV=development

# NOTE: The Anthropic API key lives in the Django backend (.env).
# It must NEVER appear here or in any NEXT_PUBLIC_ variable.
