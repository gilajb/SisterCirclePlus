# SisterCircle+ Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-render-app.onrender.com,your-custom-domain.com

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@localhost:5432/sistercircle

# ── CORS — comma-separated, no trailing slashes ──────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SimpleJWT ────────────────────────────────────────────────────────────────
REFRESH_TOKEN_LIFETIME_DAYS=7
