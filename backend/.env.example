# SisterCircle+ Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-render-app.onrender.com,your-custom-domain.com

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@localhost:5432/sistercircle

# Only set this if DATABASE_URL points at a Postgres instance shared with another,
# unrelated project (e.g. a single free-tier DB reused across apps). Isolates ALL of this
# project's tables — including Django's own django_migrations/auth/content-type tables —
# into a dedicated schema so the two projects' migration histories can never collide.
# Run `python manage.py setup_schema` once before the first `migrate` to create it.
# DB_SCHEMA=sistercircle

# ── CORS — comma-separated, no trailing slashes ──────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# ── Seed admin (manage.py seed_admin) ───────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running

# ── SimpleJWT ────────────────────────────────────────────────────────────────
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email — password reset links, verification, contact form ────────────────
# The frontend origin that password-reset emails link back to.
FRONTEND_URL=https://your-app.vercel.app
# Inbox that receives contact-form notifications. Defaults to
# sistercircleplus@protonmail.com in settings.py if left unset here.
CONTACT_EMAIL=sistercircleplus@protonmail.com

# REQUIRED in production (Render blocks outbound SMTP ports entirely — the smtp backend
# below just hangs on every send until Gunicorn kills the worker on timeout). Get this
# from Brevo: Settings > SMTP & API > API Keys tab (NOT the SMTP tab/key). Requires a
# Brevo "Sender" (single-address verification — no domain needed) matching
# DEFAULT_FROM_EMAIL exactly. Takes priority over EMAIL_HOST_USER/PASSWORD below.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@sistercircleplus.com

# SMTP — local-dev-only fallback (used only if BREVO_API_KEY is blank). Works fine on a
# normal ISP connection but NOT on Render in production. Leave EMAIL_HOST_USER/PASSWORD
# blank to print emails to the server log instead (fine for local dev with neither set).
# Any SMTP provider works locally — Gmail app password shown here, or Brevo/Postmark/
# Resend/etc.'s SMTP credentials. DEFAULT_FROM_EMAIL must match EMAIL_HOST_USER for
# Gmail specifically, unless that address is also added as a verified "Send mail as"
# alias in Gmail's own Settings > Accounts.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Sentry — error tracking ──────────────────────────────────────────────────
# Leave blank to disable Sentry entirely (no account, no network calls, no-op).
# Get a DSN from sentry.io → create a project (platform: Django) → Settings →
# Client Keys (DSN). Never sends request bodies, PII, or stack-frame local variables —
# see the SENTRY_DSN block in settings.py.
SENTRY_DSN=
